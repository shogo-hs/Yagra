msgid "**Domain**: Core workflow entities (`GraphSpec`, `NodeSpec`, `EdgeSpec`)"
msgstr ""

#: ../index.md:60
msgid "**Application**: Use cases (`build_state_graph`, `validate_workflow`)"
msgstr ""

#: ../index.md:61
msgid "**Ports**: Interfaces for extensibility (`NodeRegistryPort`)"
msgstr ""

#: ../index.md:62
msgid "**Adapters**: Implementations (file system, WebUI server)"
msgstr ""

#: ../index.md:64
msgid "Dependency rule: Outer layers depend on inner layers, never the reverse."
msgstr ""

